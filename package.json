{
  "name": "cofrin",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace frontend\" \"npm run dev --workspace backend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend && npm run build --workspace backend",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace frontend",
    "package:source": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-source.ps1",
    "lint": "npm run lint --workspace frontend && npm run lint --workspace backend"
  },
  "files": [
    "frontend/src",
    "frontend/public",
    "frontend/index.html",
    "frontend/.env.example",
    "frontend/package.json",
    "frontend/tsconfig*.json",
    "frontend/eslint.config.js",
    "frontend/vite.config.ts",
    "frontend/vitest.config.ts",
    "frontend/playwright.config.ts",
    "frontend/e2e",
    "backend/src",
    "backend/tests",
    "backend/.env.example",
    "backend/package.json",
    "backend/tsconfig.json",
    "backend/eslint.config.js",
    "docs",
    "supabase",
    "scripts",
    "README.md",
    "package-lock.json"
  ],
  "devDependencies": { "concurrently": "^9.1.2" }
}
